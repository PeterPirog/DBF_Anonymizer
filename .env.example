# Skopiuj ten plik jako .env w katalogu repozytorium i dostosuj wartości.
# .env jest ignorowany przez Git, ponieważ może zawierać dane wrażliwe.

DBF_ANON_SOURCE=D:\DANE_WOM\CWOM-B
DBF_ANON_OUTPUT=D:\Warp_directory\CWOM-B_anonymized
DBF_ANON_DICTIONARY=D:\Warp_directory\CWOM-B_dict
DBF_ANON_RECOVERED=D:\Warp_directory\CWOM-B_recovered
DBF_ANON_LOG_FILE=D:\Warp_directory\CWOM-B_conversion.log

# 0 = automatyczny dobór liczby procesów.
DBF_ANON_WORKERS=0
DBF_ANON_BATCH_SIZE=5000
DBF_ANON_LOG_LEVEL=INFO

# Automatyzacja REINDEX korzysta z COM. Ścieżka EXE służy do wczesnego
# sprawdzenia, czy wskazana instalacja VFP istnieje.
DBF_ANON_VFP_PROGID=VisualFoxPro.Application
DBF_ANON_VFP_EXE=C:\Program Files (x86)\Microsoft Visual FoxPro 9\vfp9.exe

# Używaj jednej stałej, tajnej soli dla kolejnych konwersji tej samej bazy.
# Nie publikuj jej. Pusta wartość zachowuje zgodność, ale jest słabsza przeciw
# odgadywaniu pseudonimów bez dostępu do słownika.
DBF_ANON_SALT=

# FOXUSER.DBF jest pomijany domyślnie jako zasób środowiska VFP.
# Inne tabele pomijaj tylko świadomie. Wzorce rozdzielaj średnikami.
DBF_ANON_EXCLUDE=
# Przykład awaryjny (nie włączaj zamiast odzyskania prawidłowego pomoc.cdx):
# DBF_ANON_EXCLUDE=DANE/pomoc.dbf
